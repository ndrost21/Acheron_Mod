{
  "manifest_version": 3,
  "name": "Acheron Live Mini-Map Mod",
  "version": "1.0.0",
  "description": "Always-visible live mini-map for the Acheron web dungeon crawler.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://acheron.dylanmccoyshaw.workers.dev/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "permissions": []
}
